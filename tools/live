#!/usr/bin/env bash
# Read-only check that production matches the committed deployables.
#   tools/live [site]    one line per check, non-zero exit on any failure
# LIVE_ATTEMPTS (default 1) retries each check 10s apart, so a deploy job can
# wait out Cloudflare propagation. New live checks belong here, not inline.
set -uo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
attempts=${LIVE_ATTEMPTS:-1}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
failures=0
passes=0

# fetch URL OUT -> prints "status content-type"
fetch() {
  curl -sL --max-time 20 -A 'writ-live-check' -o "$2" -w '%{http_code} %{content_type}' "$1" || true
}

# check NAME FUNC ARGS... ; FUNC prints a detail line and returns 0 on pass
check() {
  local name=$1 out i; shift
  for ((i = 1; i <= attempts; i++)); do
    if out=$("$@" 2>&1); then
      echo "PASS $name${out:+ - $out}"; passes=$((passes + 1)); return
    fi
    ((i < attempts)) && sleep 10
  done
  echo "FAIL $name - $out"; failures=$((failures + 1))
}

bust() { echo "$1?live=${GITHUB_SHA:-$$}"; }

# A committed file served byte for byte (appcast.json, site.css).
same_bytes() {
  local url=$1 file=$2 got
  got=$(fetch "$(bust "$url")" "$tmp/body")
  [[ $got == 200\ * ]] || { echo "got $got"; return 1; }
  cmp -s "$tmp/body" "$file" || { echo "200 but differs from ${file#"$root"/}"; return 1; }
  echo "200, matches $(basename "$file")"
}

# A committed page: 200 HTML carrying its committed <title> and <h1>. HTML is
# not byte-compared because Cloudflare rewrites mailto links on the way out.
page() {
  local url=$1 file=$2 got title h1
  got=$(fetch "$(bust "$url")" "$tmp/page")
  [[ $got == 200\ text/html* ]] || { echo "got $got"; return 1; }
  title=$(grep -o '<title>[^<]*</title>' "$file" | head -1)
  h1=$(tr '\n' ' ' < "$file" | grep -o '<h1[^>]*>[^<]*' | head -1 | sed 's/<h1[^>]*>//')
  grep -qF "$title" "$tmp/page" || { echo "missing $title"; return 1; }
  grep -qF "$h1" "$tmp/page" || { echo "missing h1 '$h1'"; return 1; }
  cp "$tmp/page" "$tmp/live-$(echo "$url" | tr -c 'a-z0-9' _)"
  echo "200, $title"
}

# A linked asset. Pages answers unknown paths with index.html and 200, so an
# asset must not come back as HTML unless it is itself a page.
asset() {
  local url=$1 got
  got=$(fetch "$url" "$tmp/asset")
  [[ $got == 200\ * ]] || { echo "got $got"; return 1; }
  if [[ $url == https://writ.braininavat.dance/* && $url != */ && $got == *text/html* ]]; then
    echo "200 but HTML (Pages fallback: file not deployed)"; return 1
  fi
  echo "${got%%;*}"
}

site() {
  local base=https://writ.braininavat.dance pub=$root/site/public f path link
  check "site appcast and release artifact" appcast "$base/appcast.json"
  check "site site.css" same_bytes "$base/site.css" "$pub/site.css"
  while read -r f; do
    path=/${f#"$pub"/}; path=${path%index.html}
    check "site page $path" page "$base$path" "$f"
  done < <(find "$pub" -name '*.html' | sort)

  # Every link and asset on the live pages, including what Cloudflare injects.
  cat "$tmp"/live-* 2>/dev/null | grep -oE '(href|src)="[^"]*"' | sed -E 's/^[a-z]+="//; s/"$//; s/#.*//' \
    | grep -vE '^(data:|mailto:|$)|^/cdn-cgi/l/email-protection|^https?://writ\.braininavat\.dance/appcast\.json$|^/appcast\.json$' | sort -u \
    | while read -r link; do [[ $link == /* ]] && link=$base$link; echo "$link"; done > "$tmp/links"
  while read -r link; do check "site link $link" asset "$link"; done < "$tmp/links"

}

# Follow the stable Pages redirect, validate the release feed, then download
# and hash the actual DMG. Before the first release, a missing feed is allowed
# for ordinary site deploys; release jobs set LIVE_REQUIRE_RELEASE=1.
appcast() {
  local url=${LIVE_APPCAST_URL:-$1} got code status artifact_url release_status latest_tag repo_status
  got=$(fetch "$url" "$tmp/appcast.json")
  code=${got%% *}
  if [[ $code != 200 ]]; then
    if [[ $code == 404 ]]; then
      repo_status=$(curl -sS --max-time 20 -o "$tmp/github-repo.json" -w '%{http_code}' \
        https://api.github.com/repos/braininavatgroup/writ) || {
        echo "could not verify the Writ GitHub repository"; return 1;
      }
      release_status=$(curl -sS --max-time 20 -o "$tmp/github-release.json" -w '%{http_code}' \
        https://api.github.com/repos/braininavatgroup/writ/releases/latest) || {
        echo "could not verify whether a release exists"; return 1;
      }
      if [[ $release_status == 404 && ${LIVE_REQUIRE_RELEASE:-0} != 1 ]]; then
        python3 "$root/tools/verify_release_feed.py" "$tmp/appcast.json" --verify-no-public-release \
          --repository-response "$tmp/github-repo.json" --repository-status "$repo_status" \
          --latest-response "$tmp/github-release.json" --latest-release-status "$release_status" || return 1
        echo "no GitHub release published yet; redirect is ready"
        return 0
      fi
    fi
    echo "feed request returned $got"; return 1
  fi
  if [[ -n ${LIVE_EXPECTED_RELEASE_TAG:-} ]]; then
    latest_tag=$LIVE_EXPECTED_RELEASE_TAG
  else
    release_status=$(curl -sS --max-time 20 -o "$tmp/github-release.json" -w '%{http_code}' \
      https://api.github.com/repos/braininavatgroup/writ/releases/latest) || {
      echo "could not verify latest GitHub release"; return 1;
    }
    [[ $release_status == 200 ]] || { echo "latest GitHub release returned HTTP $release_status"; return 1; }
    latest_tag=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["tag_name"])' "$tmp/github-release.json")
  fi
  if [[ -n ${LIVE_EXPECTED_VERSION:-} ]]; then
    python3 "$root/tools/verify_release_feed.py" "$tmp/appcast.json" \
      --expected-version "$LIVE_EXPECTED_VERSION" --latest-release-tag "$latest_tag" || return 1
  else
    python3 "$root/tools/verify_release_feed.py" "$tmp/appcast.json" \
      --latest-release-tag "$latest_tag" || return 1
  fi
  artifact_url=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["url"])' "$tmp/appcast.json")
  status=$(fetch "$artifact_url" "$tmp/release.dmg")
  [[ $status == 200\ * ]] || { echo "artifact returned $status"; return 1; }
  if [[ -n ${LIVE_EXPECTED_VERSION:-} ]]; then
    python3 "$root/tools/verify_release_feed.py" "$tmp/appcast.json" --artifact "$tmp/release.dmg" \
      --expected-version "$LIVE_EXPECTED_VERSION" --latest-release-tag "$latest_tag" || return 1
  else
    python3 "$root/tools/verify_release_feed.py" "$tmp/appcast.json" --artifact "$tmp/release.dmg" \
      --latest-release-tag "$latest_tag" || return 1
  fi
  echo "feed and versioned DMG verified (${status%%;*})"
}

surfaces=("$@")
[[ ${#surfaces[@]} -eq 0 ]] && surfaces=(site)
for s in "${surfaces[@]}"; do
  case $s in
    site) site ;;
    *) echo "FAIL unknown surface $s (known: site)"; failures=$((failures + 1)) ;;
  esac
done
echo "live: $passes passed, $failures failed"
((failures == 0))
